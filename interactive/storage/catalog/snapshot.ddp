-- A one-off snapshot query: the reader's chain for each requested id, computed
-- on demand from the catalog's arrangements instead of maintained (see catalog.ddp,
-- whose views this repeats for the requested ids only).
--
-- Input 0 is the ids to read, ((id), ()). The catalog is touched only at those ids:
-- each import is joined with the requested ids before anything else.

let records = import "records_up" : ((int), (int, int));
let batches = import "batches" : ((int), (int, int, int, int));
let ids = input 0 : ((int), ());

-- Upper keys are the ids themselves.
let uppers = ids | join(records, ((id), (), (_, u)) -> ((id), (u)));
let mine = ids | join(batches, ((id), (), (lo, hi, s, b)) -> ((id), (lo, hi, s, b)));

let retain = uppers | map(((id), (u)) -> ((id), (((u, HISTORY) sub, 0) max)));
let usable = mine | join(retain, ((id), (lo, hi, s, b), (r)) -> ((id, lo, hi, s, b), (r)))
           | filter(((_, _, _, s, _), (r)) -> (s, r) le)
           | map(((id, lo, hi, s, b), _) -> ((id, lo), (hi, s, b)));

let seeds = uppers | map(((id), _) -> ((id, 0), (0)));
dist: {
    let step = d | join(usable, ((id, _), (n), (hi, _, _)) -> ((id, hi), ((n, 1) add)));
    set d = (seeds + step) | min;
}
let d = dist::d;
let best = usable | join(d, ((id, lo), (hi, s, b), (n)) -> ((id, hi), (n, b, lo, s))) | min;

let tops = uppers | filter((_, (u)) -> (u, 0) gt) | map(((id), (u)) -> ((id, u), ()));
walk: {
    let prev = pts | join(best, ((id, _), (), (_, _, lo, _)) -> ((id, lo), ()));
    set pts = (tops + (prev | filter(((_, p), ()) -> (p, 0) gt))) | distinct;
}
export "snapshot" = walk::pts | join(best, ((id, hi), (), (_, b, lo, s)) -> ((id), (lo, hi, s, b)));
