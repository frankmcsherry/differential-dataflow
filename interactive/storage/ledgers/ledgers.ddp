-- Ledger state for the multi-ledger compare-and-append resolver
-- (see resolve.ddp).
--
-- `uppers` is ((ledger), (txn id, upper)): one row per ledger, the transaction
-- that last advanced it and its upper.
-- `batches` is ((ledger), (lower, upper, blob)): every appended batch, a chain
-- of half-open intervals [lower, upper) per ledger.
let uppers = input 0 : ((int), (int, int));
let batches = input 1 : ((int), (int, int, int));
export "uppers" = uppers;
export "batches" = batches;
