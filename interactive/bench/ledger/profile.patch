+fn profile_operators(diag: &crate::diag::Diagnostics,epoch: usize,worker:usize) -> Result<(),Error> {
+    use super::resolve::{wide,Row};
+    fn snapshot(diag:&crate::diag::Diagnostics,name:&str)->Result<Option<Updates>,Error> {
+        diag.snapshot(name).map(|u|Ok(Updates{keys:wide(u.keys)?,vals:wide(u.vals)?,diffs:u.diffs})).transpose()
+    }
+    fn name(row:Row<'_>)->Result<String,Error> {String::from_utf8(row.bytes()?).map_err(|e|Error::Corrupt(e.to_string()))}
+    let mut operators=BTreeMap::new();
+    let mut totals=BTreeMap::<(String,String,String),i64>::new();
+    if let Some(rows)=snapshot(diag,"diag.operator")? {
+        for index in 0..rows.len() {
+            let [_,id]=Row{value:&rows.keys,index}.product()?;
+            let [p,s,n,_]=Row{value:&rows.vals,index}.product()?;
+            operators.insert(id.integer()?,(name(p)?,name(s)?,name(n)?));
+        }
+    }
+    if let Some(rows)=snapshot(diag,"diag.time")? {
+        for index in 0..rows.len() {
+            let [_,id]=Row{value:&rows.keys,index}.product()?;
+            if let Some(desc)=operators.get(&id.integer()?) {*totals.entry(desc.clone()).or_default()+=rows.diffs[index];}
+        }
+    }
+    if let Some(rows)=snapshot(diag,"diag.time_retired")? {
+        for index in 0..rows.len() {
+            let [_,p,s,n]=Row{value:&rows.keys,index}.product()?;
+            *totals.entry((name(p)?,name(s)?,name(n)?)).or_default()+=rows.diffs[index];
+        }
+    }
+    for ((p,s,n),ns) in totals { eprintln!("OP_PROFILE epoch={} worker={} program={:?} statement={:?} operator={:?} ns={}",epoch,worker,p,s,n,ns); }
+    Ok(())
+}
