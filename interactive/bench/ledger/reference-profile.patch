 HERE = Path(__file__).resolve().parent
+import ctypes
+class Usage(ctypes.Structure):
+    _fields_ = [("uuid", ctypes.c_ubyte*16)]+[(n,ctypes.c_uint64) for n in ("user","system","idle","interrupt","pageins","wired","resident","footprint","start","exit")]
+import sys
+if sys.platform == "darwin":
+    _libproc=ctypes.CDLL("/usr/lib/libproc.dylib",use_errno=True)
+    _libproc.proc_pid_rusage.argtypes=[ctypes.c_int,ctypes.c_int,ctypes.c_void_p]
+def cpu_ns(pid):
+    if sys.platform != "darwin":
+        fields=Path(f"/proc/{pid}/stat").read_text().rsplit(")",1)[1].split()
+        return (int(fields[11])+int(fields[12]))*1_000_000_000//os.sysconf("SC_CLK_TCK")
+    info=Usage()
+    if _libproc.proc_pid_rusage(pid,0,ctypes.byref(info)): raise OSError(ctypes.get_errno(),"proc_pid_rusage")
+    class Timebase(ctypes.Structure):
+        _fields_=[("numer",ctypes.c_uint32),("denom",ctypes.c_uint32)]
+    t=Timebase()
+    ctypes.CDLL("/usr/lib/libSystem.B.dylib").mach_timebase_info(ctypes.byref(t))
+    return (info.user+info.system)*t.numer//t.denom
+


