-- Multi-shard compare-and-append, as one epoch's transaction resolution.
--
-- A transaction appends one batch to each of several shards, atomically. For
-- each shard it reads the upper it expects and writes the new upper; it commits
-- if and only if every expected upper is the shard's upper just before it, in
-- id order. Uppers only advance, so equal uppers mean no intervening append.
--
-- Input 0 is the intents, in maintained.ddp's row format:
-- ((txn, 1, shard), (expected upper)) and ((txn, 0, shard), (new upper)).
-- Input 1 is each written shard's batch: ((txn, shard), (blob)).
--
-- The resolution is resolve_by_key.ddp's. The exports:
--   `rollback`  ((txn), ())                    transactions that do not commit,
--   `delta`     ((shard), (txn, upper))         the change to `uppers`,
--   `append`    ((shard), (lower, upper, blob)) the batches to add to `batches`,
--   `garbage`   ((blob), ())                    blobs of rolled-back transactions.
-- Nothing this program holds is ever retracted; dropping it frees it.

let store = import "uppers" : ((int), (int, int));
let intents = input 0 : ((int, int, int), (int));
let blobs = input 1 : ((int, int), (int));

let reads  = intents | filter(((_, r, _), _) -> (r, 1) eq) | map(((rid, _, k), (e)) -> ((rid, k), (e)));
let wr_all = intents | filter(((_, r, _), _) -> (r, 0) eq) | map(((wid, _, k), (v)) -> ((wid, k), (v)));
let wid = wr_all | map(((wid, k), (v)) -> ((wid), (k, v)));

-- ((k), (tag, id, value)): tag 1 a read and its expected value, tag 0 a write.
let read_entries = reads | map(((rid, k), (e)) -> ((k), (1, rid, e)));
-- The store row of each key read, as a write older than any of this epoch's.
let store_entries = read_entries | join(store, ((k), _, (sw, v)) -> ((k), (0, sw, v)));

res: {
    let wr_bad = wid | join(rollback, (wid, kv, ()) -> (wid, kv));
    let writes = wid + (wr_bad | negate);
    let write_entries = writes | map(((wid), (k, v)) -> ((k), (0, wid, v)));

    -- Per key: each read against the latest write before it (absent: -1).
    let bad = (read_entries + store_entries + write_entries) | reduce((_, vals) ->
        let entries = vals map ((e, _) -> e) in
        let ws = (entries map ((t, _, _) -> (t, 0) eq), entries) zip filter in
        let rs = (entries map ((t, _, _) -> (t, 1) eq), entries) zip filter in
        let judged = (ws, rs) cap_list map ((ws, (_, i, x)) ->
            let best = ((-1, -1), (i, ws) cap_list) fold (((bid, bv), (i, (_, j, y))) ->
                (((j, i) lt, (j, bid) gt) and, (j, y), (bid, bv)) select) in
            let (bid, bv) = best in
            (((bid, -1) eq, (x, -1) ne, (bv, x) ne) select, ((i), 1))) in
        (judged map ((b, _) -> b), judged map ((_, o) -> o)) zip filter);

    set rollback = bad | map((_, (rid)) -> ((rid), ())) | distinct;
}

let rb = res::rollback;
let wbad = wid | join(rb, (wid, kv, ()) -> (wid, kv));
let committed = wid + (wbad | negate);

-- ((k), (-wid, v)): each written shard's latest committed upper this epoch.
let latest = committed | map(((wid), (k, v)) -> ((k), (wid neg, v))) | min;
let new_rows = latest | map(((k), (nw, v)) -> ((k), (nw neg, v)));
let old_rows = latest | join(store, ((k), _, (sw, sv)) -> ((k), (sw, sv)));

-- Each committed write's batch is [expected upper, new upper) of its shard.
let bounds = committed | map(((wid), (k, v)) -> ((wid, k), (v)))
           | join(reads, ((wid, k), (hi), (lo)) -> ((wid, k), (lo, hi)));
let appended = bounds | join(blobs, ((_, k), (lo, hi), (b)) -> ((k), (lo, hi, b)));

-- Blobs written by rolled-back transactions, for the writer to delete.
let lost = blobs | map(((txn, _), (b)) -> ((txn), (b))) | join(rb, (_, (b), ()) -> ((b), ()));

export "rollback" = rb;
export "delta" = new_rows + (old_rows | negate);
export "append" = appended;
export "garbage" = lost;
