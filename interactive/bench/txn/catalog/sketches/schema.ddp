-- The durable catalog's schema: names bind to shard ids, and shard ids own batches.
type Content = Hash int | Inline List(int);           -- a batch's updates: a blob by hash, or in band
type Binding = Shard int | Dir int | Mount List(int);  -- what a name refers to

-- (directory, name) -> binding. Renames and moves change only these rows.
let names = input 0 : ((int, List(int)), (Binding));
-- (shard id) -> (declared shape, as text). Written once, at creation.
let shapes = input 1 : ((int), (List(int)));
-- (shard id) -> (upper, since, generation). The compare-and-swap cells.
let frontiers = input 2 : ((int), (int, int, int));
-- (shard id) -> (lower, upper, since, content). The batches.
let batches = input 3 : ((int), (int, int, int, Content));

-- A read: (directory, name) -> each batch of the shard bound there, with its shape.
let wanted = input 4 : ((int, List(int)), ());
let ids = wanted | join(names, (_, (), (b)) -> ((b match (Shard (i -> i), Dir (_ -> -1), Mount (_ -> -1))), ()))
                 | filter(((i), ()) -> (i, 0) ge);
export "shard_batches" = ids | join(batches, ((i), (), (lo, hi, s, c)) -> ((i), (lo, hi, s, c)));
export "shard_shape" = ids | join(shapes, ((i), (), (t)) -> ((i), (t)));
