-- IC6: request(request_id, person_id, tag_name). Two-hop tag co-occurrence.
-- Alternative: build a reusable (author, tag) -> post index before binding requests.
let request = input 0 : ((int, int, List(int)) ; ());
let edge = import "edge" : ((int) ; (int, int));
let message = import "message" : ((int) ; (int, int, int));
let tagged = import "tagged" : ((int) ; (List(int)));
-- Reachable rows: (request_id, origin, author, tag_name), deduplicated across paths.
let one = request | key(((rid, pid, tag), ()) -> ((pid), (rid, tag)))
    | join(edge, ((pid), (rid, tag), (q, _)) -> ((rid, pid, q, tag), ()));
let two = one | key(((rid, origin, author, tag), ()) -> ((author), (rid, origin, tag)))
    | join(edge, (_, (rid, origin, tag), (q, _)) -> ((rid, origin, q, tag), ()));
let authors = (one + two) | filter(((_, origin, author, _), ()) -> (origin, author) ne) | distinct;
-- This full graph index moves work to setup/base updates; report that cost separately.
let tagged_posts = message | filter((_, (kind, _, _)) -> (kind, 0) eq)
    | join(tagged, ((m), (_, creator, _), (name)) -> ((creator, name), m)) | arrange;
let selected = authors | key(((rid, _, author, tag), ()) -> ((author, tag), rid))
    | join(tagged_posts, ((_, tag), rid, m) -> ((rid, m, tag), ())) | distinct;
let counts = selected | key(((rid, m, tag), ()) -> ((m), (rid, tag)))
    | join(tagged, (_, (rid, tag), (name)) -> ((rid, name, tag), ()))
    | filter(((_, name, tag), ()) -> (name, tag) ne) | map(((rid, name, _), ()) -> ((rid, name), ())) | count;
export "ic6.answer" = counts | key(((rid, name), n) -> (rid, (n neg, name)))
    | collect | flatmap((_, vs) -> vs) | filter((_, (pos, _)) -> (pos, 10) lt)
    | map((rid, (pos, (negn, name))) -> ((rid, pos), (name, negn neg)));
