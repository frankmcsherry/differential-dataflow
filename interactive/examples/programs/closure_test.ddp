-- Probe: occupied-chain transitive closure via squaring, edge carried in the KEY
-- (so `distinct` dedups whole edges rather than collapsing the value away).
let succ = input 0 | key($0[0] ; $0[1]);
let occ  = input 1 | key($0[0] ;);
let oc   = occ | join(succ, ($2 ; $0)) | join(occ, ($1 ; $0));
sq: {
    var closure = (oc | key($0, $1 ;))
                + ((closure | key($0[1] ; $0[0])) | join((closure | key($0[0] ; $0[1])), ($1, $2 ;)))
                | distinct;
}
export "result" = sq::closure | arrange;
