-- The rules a change to the state of a system of ledgers should keep (see system.ddp).
--
-- A step is the state before a change, the state after it, and who made it.
-- The rules in system.ddp read one state. These read both, and so can say what may not be undone.
--
--   input 0, before   : ((entry), ())                 the entries before the step
--   input 1, after    : ((entry), ())                 the entries after it
--   input 2, stood    : ((id), (version, frontier))   each ledger's standing before, as system.ddp derives it
--   input 3, stands   : ((id), (version, frontier))   each ledger's standing after
--   input 4, actor    : ((), (actor))                 who made the change: a user, or a runner of a computation
--
-- Each output should be empty. As in system.ddp, where and when a rule is run is not said here.
-- These rules are choices. What may be let go is not said here: system.ddp says that a state
-- keeps each ledger readable from each frontier a reader needs, and a step that ends in such a state lets go what it likes.

type Id = (int, int);
type Bytes = List(int);
type Shape = Bytes;             -- the shape of a ledger's rows
type Text = Bytes;              -- a name, or a program's text
type Hash = Bytes;              -- what a program or a blob is known by
type Time = List(int);          -- one int per coordinate
type Frontier = List(Time);
enum Batch = Empty | Inline Bytes | Blob Hash;
enum Clock = Free | Follows Id;
enum Keep = Durable | Derived;
enum Input = State | Read Id;
enum Output = Unwritten | Written Id;
enum Entry = Ledger ((Id), (Shape, int, Frontier, Clock, Keep))
           | Span ((Id, int, int, Frontier), (Frontier, Frontier, Batch))
           | Name ((Text), (Id))
           | Program ((Hash), (List(Shape), List(Shape), Text))
           | Computation ((Id), (Hash, List(Input), List(Output)))
           | Run ((Id, Id), ())
           | Hold ((Id, Id), (Frontier));
enum Actor = User | Runner Id;

let before = input 0 : ((Entry), ()) | distinct;
let after = input 1 : ((Entry), ()) | distinct;
let stood = input 2 : ((Id), (int, Frontier));
let stands = input 3 : ((Id), (int, Frontier));
let actor = input 4 : ((), (Actor));

-- THE CHANGE: the entries the step removed, and the entries it added.
let removed = before - (before | join(after, (entry, (), ()) -> (entry, ())));
let added = after - (after | join(before, (entry, (), ()) -> (entry, ())));

-- Each by its table's key. A key that is both removed and added is a row that was changed.
let ledgers_out = removed((Ledger(((id), _))), ());
let ledgers_in = added((Ledger(((id), _))), ());
let spans_out = removed((Span(((id, from, to, since), _))), ());
let spans_in = added((Span(((id, from, to, since), (lower, upper, _)))), ())
             | map(((id, from, to, since, lower, upper), ()) -> ((id, from, to, since), (lower, upper)));
let programs_out = removed((Program(((program), _))), ());
let programs_in = added((Program(((program), _))), ());
let computations_out = removed((Computation(((computation), _))), ());
let computations_in = added((Computation(((computation), _))), ());

-- WHAT IS WRITTEN STAYS WRITTEN. None of these changes, so none has a key that is both removed and added.
-- A ledger's spans are read by its width, its start and its clock. A program's hash is what others know it by.
-- A computation's outputs are defined by its program and its inputs, so another program or other inputs
-- are another computation, with another id.
-- Covering the same appends again, at another since or merged with others, changes nothing, and is not caught here.
output "reshaped"  = ledgers_out((id), ())                * ledgers_in((id), ());                 -- a registration
output "rewritten" = spans_out((id, from, to, since), ()) * spans_in((id, from, to, since), _);   -- a span, at one since
output "reworded"  = programs_out((program), ())          * programs_in((program), ());           -- a program
output "rebound"   = computations_out((computation), ())  * computations_in((computation), ());   -- a computation

-- A ledger's version and write frontier do not go back: (ledger, ((version, frontier) before, (version, frontier) after)).
output "regressed" = stood | join(stands, (id, was, is) -> (id, (was, is)))
                           | filter((_, ((version, frontier), (later, after))) ->
                                 (((version, later) le, (frontier, after) call frontier_le) all, 0) eq);

-- An append keeps the frontiers it began and ended at: (ledger, (side, number, frontier)).
-- EDGES are as in system.ddp: where each append begins, side 0, and where each ends, side 1.
-- A span added within a ledger's version covers again what was there, so each edge it has was there before.
let spans_was = before((Span(((id, from, to, _), (lower, upper, _)))), ());
let edges_was = (spans_was | map(((id, from, _, lower, _), ()) -> ((id, 0, from, lower), ())))
              + (spans_was | map(((id, _, to, _, upper), ()) -> ((id, 1, (to, 1) sub, upper), ())))
              | distinct;
let edges_in = (spans_in | map(((id, from, _, _), (lower, _)) -> ((id, 0, from, lower), ())))
             + (spans_in | map(((id, _, to, _), (_, upper)) -> ((id, 1, (to, 1) sub, upper), ())))
             | distinct;
let fresh = edges_in - (edges_in | join(edges_was, (edge, (), ()) -> (edge, ())));
output "revised" = fresh((id, side, number, frontier), ()) * stood((id), (version, _))
                 | filter(((_, _, number, _, version), ()) -> (number, version) lt)
                 | map(((id, side, number, frontier, _), ()) -> ((id), (side, number, frontier)));

-- APPENDS.

-- A span added across the end of a ledger's version begins at the version, and at the ledger's write frontier:
-- (ledger, (from, to, lower, frontier)).
-- So its writer knew all that the ledger had, no time is passed over, and no span covers old appends with new.
-- A span added past the version breaks a rule of system.ddp, unless it follows another added in this step.
-- This says nothing of a ledger registered in this same step, which has no standing before it.
-- The two frontiers are equal when each is at or before the other, however either is written.
output "detached" = spans_in((id, from, to, _), (lower, _)) * stood((id), (version, frontier))
                  | filter(((_, from, to, lower, version, frontier), ()) ->
                        let same = ((lower, frontier) call frontier_le, (frontier, lower) call frontier_le) all in
                        let begins = ((from, version) eq, same) all in
                        ((from, version) le, (version, to) lt, (begins, 0) eq) all)
                  | map(((id, from, to, lower, _, frontier), ()) -> ((id), (from, to, lower, frontier)));

-- Only a runner of its computation adds to a bound ledger: (ledger, (from, computation)).
-- A ledger is bound by the state after the step, so a step may bind a ledger and add to it, or unbind it and add to it.
-- GROWS is each span that adds to its ledger: one that goes past the version, or is of a ledger registered in this step.
-- A span added within the version covers again what was there, and anyone may add it.
let grows = (spans_in((id, from, to, _), _) * stood((id), (version, _))
             | filter(((_, _, to, version), ()) -> (to, version) gt)
             | map(((id, from, _, _), ()) -> ((id), (from))))
          + (spans_in((id, from, _, _), _) * ledgers_in((id), ()) | map(((id, from), ()) -> ((id), (from))));
let outs = after((Computation(((computation), (_, _, outputs)))), ())
         | flatmap(((computation, outputs), ()) ->
                   (computation, outputs) cap_list map ((computation, output) -> ((computation), (output))));
let bound = outs((computation), (Written(ledger))) | map(((computation, ledger), ()) -> ((ledger), (computation))) | distinct;
let acting = actor((), (Runner(computation))) | distinct;
let claimed = grows | join(bound, (ledger, (from), (computation)) -> ((computation), (ledger, from)));
output "usurped" = (claimed - (claimed | join(acting, (computation, place, ()) -> (computation, place))))
                 | map(((computation), (ledger, from)) -> ((ledger), (from, computation)));
