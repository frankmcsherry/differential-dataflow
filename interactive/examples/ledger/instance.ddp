-- What an instance asks of the entries it is told: what to run, where its ledgers stand, and which spans to read.
--
-- An instance keeps this in its own server, over its copy of the entries (see bundle.ddp, and runner.py).
-- The instance acts on what these views say. Its Python decides a few things itself (runner.py): where a computation
-- begins, the least of its `resumes`; whether its outputs stand apart; and whether another wrote its outputs.
--
--   input 0, entries : ((entry), ())                       the entries the instance is told
--   input 1, me      : ((instance), ())                    the instance's own id
--   input 2, readers : ((reader), (ledger, read, need))    each reader the instance has of a durable ledger
--
-- A reader is something in the instance that reads a ledger's appends in order. The instance names it as it likes,
-- with two ints after a computation's id. `read` is the number of the ledger's appends it has read.
-- `need` is the frontier it reads from: it can use a span whose since is at or before the need and the span's lower
-- together. `forgotten` in system.ddp asks the same of times of one coordinate; of times of more, it asks more, a
-- since at or before the need alone, and so may call a ledger unreadable where this finds spans to read.
-- The empty frontier is after every time, so a reader with that need
-- can use any span: it is for one that wants what the ledger holds in the end, and not when.
--
--   plan     : ((computation), (inputs, outputs, takes, gives, text))   each computation the instance is asked to run,
--                                                                  with the shapes and the text of its program
--   binds    : ((computation, position), (writer, place))          each input that reads a derived ledger, and the
--                                                                  output of the computation that writes it
--   standing : ((ledger), (version, frontier))                     each durable ledger's version and write frontier
--   resumes  : ((computation), (target, frontier))                 each durable ledger a computation's outputs reach,
--                                                                  and where it stands: the computation begins from there
--   fetch    : ((reader), (from, to, batch))                       the spans a reader reads next, which lead from the
--                                                                  appends it has read to the ledger's last
--   stuck    : ((reader), ())                                      a reader that no spans lead on from where it has read
--
-- A reader is stuck when the appends it has read were merged with ones it has not. It then reads the ledger again
-- from its first append, which the rules promise it can for a need the state knows of.

type Id = (int, int);
type Bytes = List(int);
type Shape = Bytes;             -- the shape of a ledger's rows
type Text = Bytes;              -- a name, or a program's text
type Hash = Bytes;              -- what a program or a blob is known by
type Time = List(int);          -- one int per coordinate
type Frontier = List(Time);
enum Batch = Empty | Inline Bytes | Blob Hash;
enum Clock = Free | Follows Id;
enum Keep = Durable | Derived;
enum Input = State | Read Id;
enum Output = Unwritten | Written Id;
enum Entry = Ledger ((Id), (Shape, int, Frontier, Clock, Keep))
           | Span ((Id, int, int, Frontier), (Frontier, Frontier, Batch))
           | Name ((Text), (Id))
           | Program ((Hash), (List(Shape), List(Shape), Text))
           | Computation ((Id), (Hash, List(Input), List(Output)))
           | Run ((Id, Id), ())
           | Hold ((Id, Id), (Frontier));
type Reader = (Id, int, int);

let entries = input 0 : ((Entry), ());
let me = input 1 : ((Id), ());
let readers = input 2 : ((Reader), (Id, int, Frontier));

let table = entries | distinct;
let ledgers = table((Ledger((key, val))), ()) | map(((key, val), ()) -> (key, val));
let spans = table((Span((key, val))), ()) | map(((key, val), ()) -> (key, val));
let programs = table((Program((key, val))), ()) | map(((key, val), ()) -> (key, val));
let computations = table((Computation((key, val))), ()) | map(((key, val), ()) -> (key, val));
let runs = table((Run((key, val))), ()) | map(((key, val), ()) -> (key, val));

let durable = ledgers((id), (_, _, _, _, Durable)) | distinct;
let derived = ledgers((id), (_, _, _, _, Derived)) | distinct;

-- PLAN: each computation this instance is asked to run, with its program's text.
-- An instance that reads the state is told of every run, so its own are picked out.
output "plan" = runs((instance, computation), ()) * me((instance), ())
              * computations((computation), (program, inputs, outputs)) * programs((program), (takes, gives, text))
              | map(((_, computation, _, inputs, outputs, takes, gives, text), ()) -> ((computation), (inputs, outputs, takes, gives, text)));

-- BINDS: a derived ledger is the output of the computation that writes it, inside the instance's server.
-- A computation here that reads one is bound to that output.
let ins = computations | flatmap(((computation), (_, inputs, _)) ->
              (computation, ((0, inputs len) range, inputs) zip) cap_list
              map ((computation, (position, input)) -> ((computation, position), (input))));
let outs = computations | flatmap(((computation), (_, _, outputs)) ->
               (computation, ((0, outputs len) range, outputs) zip) cap_list
               map ((computation, (position, output)) -> ((computation, position), (output))));
let reads = ins((computation, position), (Read(ledger))) | map(((computation, position, ledger), ()) -> ((ledger), (computation, position)));
let writes = outs((computation, position), (Written(ledger))) | map(((computation, position, ledger), ()) -> ((ledger), (computation, position)));
output "binds" = reads((ledger), (reader, position)) * derived((ledger), ()) * writes((ledger), (writer, place))
               | map(((_, reader, position, writer, place), ()) -> ((reader, position), (writer, place)));

-- STANDING, as in system.ddp.
-- OWN: a ledger's version is the number of its appends, and its own upper is the upper of the span that covers
-- the last of them, or its start if it has none.
-- MARKS is each number a ledger has come to, with the upper there: 0 with its start, and where each span ends.
-- A TIP is a mark that no span begins at. The version is the greatest tip, and there are few of them: one, unless
-- spans were discarded and left others that lead nowhere. So an append changes two rows here, and no more,
-- however many spans the ledger has.
let marks = (ledgers | map(((id), (_, _, start, _, _)) -> ((id, 0), (start))))
          + (spans | map(((id, _, to, _), (_, upper, _)) -> ((id, to), (upper))));
let started = spans | filter(((_, from, to, _), _) -> (from, to) lt) | map(((id, from, _, _), _) -> ((id, from), ())) | distinct;
let tips = marks - (marks | join(started, (place, upper, ()) -> (place, upper)));
let own = tips | map(((id, to), (upper)) -> ((id), (to, upper)))
               | reduce((_id, marks) -> ((marks len, 1) sub enlist, marks) gather map ((mark, _count) -> (mark, 1)));
-- WRITE FRONTIER: the join of a ledger's own upper with the write frontier of the clock it follows, and so on up.
let followed = ledgers((id), (_, _, _, Follows(clock), _)) | map(((id, clock), ()) -> ((clock), (id)));
wf: {
    let lifted = followed | join(write, ((clock), (id), (frontier)) -> ((id), (frontier)));
    set write = (own | map((id, (_, upper)) -> (id, (upper)))) + lifted
              | reduce((_id, frontiers) ->
                    let none = [] : List(List(int)) in
                    let joined = ((0, none), frontiers) fold (((seen, sofar), ((frontier), _count)) ->
                        (1, (seen, (sofar, frontier) call frontier_join, frontier) select)) in
                    ((joined.1), 1) enlist);
}
let standing = own((id), (version, _)) * wf::write((id), (frontier)) * durable((id), ())
             | map(((id, version, frontier), ()) -> ((id), (version, frontier)));
output "standing" = standing;

-- RESUMES, as in system.ddp: a computation begins from where its outputs stand. A derived ledger stands nowhere,
-- so the computation that writes one begins from where its readers do, and so on back.
-- A hold on a derived ledger is not passed back here: an instance is not told of holds.
let relies = reads((ledger), (reader, _)) * derived((ledger), ()) * writes((ledger), (writer, _))
           | map(((ledger, reader, writer), ()) -> ((reader), (writer, ledger)));
let stands = writes | join(standing, ((ledger), (computation, _), (_, frontier)) -> ((computation), (ledger, frontier)));
resuming: {
    let passed = relies | join(resumes, ((reader), (writer, _), (target, frontier)) -> ((writer), (target, frontier)));
    set resumes = stands + passed | distinct;
}
output "resumes" = resuming::resumes;

-- FETCH: the spans that lead a reader on from the appends it has read to the ledger's last.
-- All of this is written so that an append to a ledger changes a few rows for each of its readers, and no more,
-- however many spans the ledger has.

-- HOPS is each span a reader can use, as a step from one number to another: ((reader, from), (to, batch)).
-- A span whose since is at or before its lower is PLAIN: it holds each update at the time it was written, and a
-- reader with any need can use it. A span is plain as it is appended. The rest are PACKED, by a merge, and a
-- reader can use one when its since is at or before the reader's need and the span's lower together.
-- The two are kept apart because a reader's need moves as it reads: it is asked only of the packed spans.
let strides = spans | filter(((_, from, to, _), _) -> (from, to) lt);
let plain = strides | filter(((_, _, _, since), (lower, _, _)) -> (since, lower) call frontier_le);
let packed = strides | filter(((_, _, _, since), (lower, _, _)) -> ((since, lower) call frontier_le, 0) eq);
let reading = readers | map(((reader), (id, _, _)) -> ((id), (reader)));
let seeking = readers | map(((reader), (id, _, need)) -> ((id), (reader, need)));
let hops = (plain((id, from, to, _), (_, _, batch)) * reading((id), (reader))
            | map(((_, from, to, batch, reader), ()) -> ((reader, from), (to, batch))))
         + (packed((id, from, to, since), (lower, _, batch)) * seeking((id), (reader, need))
            | filter(((_, _, _, since, lower, _, _, need), ()) -> (since, (need, lower) call frontier_join) call frontier_le)
            | map(((_, from, to, _, _, batch, reader, _), ()) -> ((reader, from), (to, batch))))
         | distinct;

-- DEAD is each number from which hops do not lead to the ledger's version: it is not the version, and every hop
-- that leaves it goes to a dead number. So a number that no hop leaves is dead, unless it is the version.
-- The dead numbers are found, and not the ones that lead on, because an append makes no number dead. The numbers
-- that lead on are each some steps from the version, and an append would move every one of them a step further.
-- A reader can only come to a number where a hop begins or ends, where it has read to, or the version: PLACES.
let ends = readers((reader), (id, _, _)) * own((id), (version, _)) | map(((reader, _, version), ()) -> ((reader, version), ()));
let begins = readers | map(((reader), (_, read, _)) -> ((reader, read), ()));
let leaving = hops | map((place, _) -> (place, ()));
let places = leaving + (hops | map(((reader, _), (to, _)) -> ((reader, to), ()))) + begins + ends | distinct;
-- HALTS is each place that no hop leaves, other than the version. No hop leaves the version.
let left = leaving | distinct;
let halts = places - (places | join(left, (place, (), ()) -> (place, ()))) - ends;
-- WAYS is how many hops leave each place, and BACK is each hop, by the place it goes to.
let ways = leaving | count;
let back = hops | map(((reader, from), (to, _)) -> ((reader, to), (from)));
leading: {
    -- LOST is how many of the hops that leave a place go to a dead one. The place is dead when that is all of them.
    let lost = back | join(dead, ((reader, _), (from), ()) -> ((reader, from), ())) | count;
    let spent = lost | join(ways, (place, astray, leave) -> (place, (astray, leave)))
                     | filter((_, (astray, leave)) -> (astray, leave) eq)
                     | map((place, _) -> (place, ()));
    set dead = halts + spent | distinct;
}
-- BEST is, from each place, the hop to take: of those that go to a place that is not dead, the one that goes
-- furthest. The hops from a place are handed over in order, and the last is kept.
let onward = hops | map(((reader, from), (to, batch)) -> ((reader, to), (from, batch)));
let best = onward - (onward | join(leading::dead, (place, step, ()) -> (place, step)))
         | map(((reader, to), (from, batch)) -> ((reader, from), (to, batch)))
         | reduce((_place, steps) -> ((steps len, 1) sub enlist, steps) gather map ((step, _count) -> (step, 1)));
-- AT is each place the reader comes to: where it has read to, and where each best hop takes it.
walking: {
    let next = at | join(best, ((reader, _), (), (to, _)) -> ((reader, to), ()));
    set at = begins + next | distinct;
}
output "fetch" = walking::at | join(best, ((reader, from), (), (to, batch)) -> ((reader), (from, to, batch)));

-- STUCK: a reader whose place is dead.
output "stuck" = begins | join(leading::dead, (place, (), ()) -> (place, ()))
               | map(((reader, _), ()) -> ((reader), ()));
