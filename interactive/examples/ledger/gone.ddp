-- What a drop does to the keeper's generations: it marks the dropped ledger's, as a pass of merges does.
--
-- The keeper holds no spans. A follower that applies a drop takes the dropped ledger's spans out of its copy itself
-- (see follower.py): a span whose ledger is not registered is an orphan, and every follower finds the same ones at the
-- same record. Its row leaves through shift.ddp, and its own hold through commands.ddp, with the ledger.
-- Its generation stays, and becomes the log's length at the drop. So a compactor that read before the drop is late
-- (pass.ddp, `refused`), even if the id is registered again: what it read is not that ledger's.
-- One row stays for each ledger that was ever dropped.
--
--   input 0, dropped : ((id), ())          the ledgers the transaction in hand drops (see shift.ddp)
--   input 1, gens    : ((id), (number))    each ledger's generation
--   input 2, now     : ((), (length))      the log's length once the transaction in hand is written
--
--   marked  : ((id), (number))       the change to the generations: each dropped ledger's is now the log's length

type Id = (int, int);
type Bytes = List(int);
type Shape = Bytes;             -- the shape of a ledger's rows
type Text = Bytes;              -- a name, or a program's text
type Hash = Bytes;              -- what a program or a blob is known by
type Time = List(int);          -- one int per coordinate
type Frontier = List(Time);
enum Batch = Empty | Inline Bytes | Blob Hash;
enum Clock = Free | Follows Id;
enum Keep = Durable | Derived;
enum Input = State | Read Id;
enum Output = Unwritten | Written Id;
enum Entry = Ledger ((Id), (Shape, int, Frontier, Clock, Keep))
           | Span ((Id, int, int, Frontier), (Frontier, Frontier, Batch))
           | Name ((Text), (Id))
           | Program ((Hash), (List(Shape), List(Shape), Text))
           | Computation ((Id), (Hash, List(Input), List(Output)))
           | Run ((Id, Id), ())
           | Hold ((Id, Id), (Frontier));

let dropped = input 0 : ((Id), ());
let gens = input 1 : ((Id), (int));
let now = input 2 : ((), (int));
let before = gens | join(dropped, (id, (number), ()) -> (id, (number)));
let after = dropped | map((id, ()) -> ((), (id))) | join(now, ((), (id), (length)) -> (id, (length)));
output "marked" = after - before;
